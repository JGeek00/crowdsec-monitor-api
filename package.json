{
  "name": "crowdsec-monitor-api",
  "version": "1.16.0-beta.3",
  "description": "Self-hosted API to monitor a CrowdSec instance: REST API, WebSocket, notifications, and an MCP server for AI assistants",
  "license": "MIT",
  "author": "JGeek00",
  "repository": {
    "type": "git",
    "url": "https://github.com/JGeek00/crowdsec-monitor-api.git"
  },
  "type": "commonjs",
  "main": "dist/server.js",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon",
    "dev:no-nodemon": "tsx --tsconfig tsconfig.app.json src/server.ts",
    "build:dev": "tsc -p tsconfig.app.json && tsc-alias -p tsconfig.app.json && node scripts/copy-templates.js",
    "bump-version:major": "node scripts/bump-version.js major",
    "bump-version:major:beta": "node scripts/bump-version.js major beta",
    "bump-version:minor": "node scripts/bump-version.js minor",
    "bump-version:minor:beta": "node scripts/bump-version.js minor beta",
    "bump-version:bugfix": "node scripts/bump-version.js bugfix",
    "bump-version:bugfix:beta": "node scripts/bump-version.js bugfix beta",
    "bump-version:beta": "node scripts/bump-version.js beta",
    "build:prod": "pnpm run build:prod:compile && pnpm run build:prod:obfuscate",
    "build:prod:compile": "tsc -p tsconfig.app.json --sourceMap false --declaration false --declarationMap false && tsc-alias -p tsconfig.app.json && node scripts/copy-templates.js",
    "build:prod:obfuscate": "node scripts/obfuscate.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:unit:coverage": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sequelize/core": "7.0.0-alpha.48",
    "@sequelize/postgres": "7.0.0-alpha.48",
    "@sequelize/sqlite3": "7.0.0-alpha.48",
    "axios": "1.20.0",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-validator": "7.3.2",
    "handlebars": "4.7.10",
    "helmet": "8.3.0",
    "morgan": "1.12.1",
    "nodemailer": "10.2.0",
    "sqlite3": "npm:@vscode/sqlite3@5.1.14-vscode",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "javascript-obfuscator": "5.9.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsc-alias": "1.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
}
