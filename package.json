{
  "name": "crowdsec-monitor-api",
  "version": "1.15.0-beta.2",
  "description": "REST API server for CrowdSec LAPI",
  "license": "MIT",
  "author": "JGeek00",
  "repository": {
    "type": "git",
    "url": "https://github.com/JGeek00/crowdsec-monitor-api.git"
  },
  "type": "commonjs",
  "main": "dist/server.js",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon",
    "dev:no-nodemon": "ts-node -P tsconfig.app.json -r tsconfig-paths/register src/server.ts",
    "build:dev": "tsc -p tsconfig.app.json && tsc-alias -p tsconfig.app.json",
    "bump-version:major": "node scripts/bump-version.js major",
    "bump-version:major:beta": "node scripts/bump-version.js major beta",
    "bump-version:minor": "node scripts/bump-version.js minor",
    "bump-version:minor:beta": "node scripts/bump-version.js minor beta",
    "bump-version:bugfix": "node scripts/bump-version.js bugfix",
    "bump-version:bugfix:beta": "node scripts/bump-version.js bugfix beta",
    "bump-version:beta": "node scripts/bump-version.js beta",
    "build:prod": "pnpm run build:prod:compile && pnpm run build:prod:obfuscate",
    "build:prod:compile": "tsc -p tsconfig.app.json --sourceMap false --declaration false --declarationMap false && tsc-alias -p tsconfig.app.json",
    "build:prod:obfuscate": "node scripts/obfuscate.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/utils tests/validators tests/constants tests/helpers tests/services tests/config",
    "test:unit:coverage": "vitest run tests/utils tests/validators tests/constants tests/helpers tests/services tests/config --coverage",
    "test:integration": "vitest run tests/controllers tests/routes tests/middlewares tests/app.test.ts",
    "test:e2e": "vitest run tests/sockets tests/e2e-*.test.ts tests/app.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sequelize/core": "7.0.0-alpha.48",
    "@sequelize/postgres": "7.0.0-alpha.48",
    "@sequelize/sqlite3": "7.0.0-alpha.48",
    "axios": "1.20.0",
    "cors": "2.8.6",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-validator": "7.3.2",
    "helmet": "8.3.0",
    "morgan": "1.12.1",
    "nodemailer": "10.0.12",
    "sqlite3": "npm:@vscode/sqlite3@5.1.14-vscode",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/morgan": "1.9.10",
    "@types/node": "26.6.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitest/coverage-v8": "5.0.1",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.12.0",
    "javascript-obfuscator": "5.8.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.5",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.1"
  }
}
